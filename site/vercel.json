{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/en",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/:path+",
      "destination": "/:path+",
      "permanent": true
    },
    {
      "source": "/blog/zero-affirmation-non-sourcee/",
      "destination": "/fr/blog/zero-affirmation-non-sourcee/",
      "permanent": true
    },
    {
      "source": "/blog/le-budget-d-antenne/",
      "destination": "/fr/blog/le-budget-d-antenne/",
      "permanent": true
    },
    {
      "source": "/blog/la-source-qu-on-n-a-pas-pu-lire/",
      "destination": "/fr/blog/la-source-qu-on-n-a-pas-pu-lire/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
