.DS_Store
# No trailing slash: with one this matches a directory but not a SYMLINK to
# one, and a git worktree can only have the symlink -- dependencies are
# installed once in the main checkout. Every worktree therefore showed an
# untracked node_modules, which is noise and, worse, something a broad
# `git add` would commit.
node_modules
.env
.env.*
dist/
.data/
eval/out/
phase2_script_*-audio/
.vercel
ios/**/xcuserdata/
ios/**/*.xcworkspace/xcuserdata/
ios/build/
.tools/
