{
  "name": "podcapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/api/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "eval:cache": "tsx eval/cache.ts",
    "eval:run": "tsx eval/run.ts",
    "eval:episode": "tsx eval/episode.ts",
    "inspect": "tsx src/cli.ts",
    "tts": "tsx src/tts.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "reassemble": "tsx src/reassemble.ts",
    "storage:check": "tsx src/storage/check.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@hono/node-server": "^1.13.7",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.15",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "ffmpeg-static": "^5.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}